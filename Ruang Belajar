          ["Bakteri baik di usus besar berfungsi untuk…",["Membunuh semua kuman","Membantu memecah makanan dan vitamin","Menghancurkan protein","Mengubah amilum","Menghasilkan asam lambung"],1],
          ["Feses terbentuk di…",["Mulut","Lambung","Usus halus","Usus besar","Rektum"],3],
          ["Sensor di rektum berfungsi untuk…",["Menghancurkan makanan","Memberi sinyal ke otak saat feses atau gas ingin keluar","Mengubah protein","Menghasilkan enzim","Menyerap vitamin"],1],
          ["Waktu makanan berada di lambung rata-rata…",["1 jam","2–5 jam","6 jam","10 jam","24 jam"],1]
        ]
      }
    ];

    const allQuestions = levels.flatMap(level => level.questions);
    const totalQuestions = allQuestions.length;
    const letters = ["A","B","C","D","E"];
    const el = id => document.getElementById(id);
    let currentLevel = 0;
    let currentQuestion = 0;
    let answers = Array(totalQuestions).fill(null);
    let unlockedLevel = 0;
    let seconds = 900;
    let timerId;

    const globalIndex = () => levels.slice(0,currentLevel).reduce((sum,level)=>sum + level.questions.length,0) + currentQuestion;

    function updateTabs(){
      levels.forEach((level,index)=>{
        const button = el("level-" + index);
        const start = levels.slice(0,index).reduce((sum,item)=>sum + item.questions.length,0);
        const done = level.questions.every((_,questionIndex)=>answers[start + questionIndex] !== null);
        button.disabled = index > unlockedLevel;
        button.classList.toggle("active",index === currentLevel);
        button.classList.toggle("complete",done && index < unlockedLevel);
      });
    }

    function renderNav(){
      const navigation = el("question-nav");
      navigation.replaceChildren();

      levels[currentLevel].questions.forEach((_,index)=>{
        const questionIndex = globalIndex() - currentQuestion + index;
        const button = document.createElement("button");
        button.type = "button";
        button.className = "question-dot mono h-9 w-9 rounded-full text-sm font-bold";
        button.textContent = index + 1;
        button.setAttribute("aria-label","Buka soal " + (questionIndex + 1));

        if(index === currentQuestion) button.classList.add("active");
        else if(answers[questionIndex] !== null) button.classList.add("done");

        button.addEventListener("click",()=>{
          currentQuestion = index;
          renderQuestion();
        });

        navigation.appendChild(button);
      });

      updateTabs();
    }

    function renderQuestion(){
      const question = levels[currentLevel].questions[currentQuestion];
      const index = globalIndex();

      el("question-number").textContent = String(index + 1).padStart(2,"0");
      el("level-name").textContent = levels[currentLevel].name;
      el("question-text").textContent = question[0];
      el("progress-text").textContent = (index + 1) + " / " + totalQuestions;
      el("progress-bar").style.width = ((index + 1) / totalQuestions * 100) + "%";

      const list = el("answer-list");
      list.replaceChildren();

      question[1].forEach((option,optionIndex)=>{
        const button = document.createElement("button");
        button.type = "button";
        button.className = "answer-option w-full rounded-2xl p-4 text-left font-medium";
        button.setAttribute("role","radio");
        button.setAttribute("aria-checked",answers[index] === optionIndex);

        if(answers[index] === optionIndex) button.classList.add("selected");

        const inner = document.createElement("span");
        inner.className = "flex items-center gap-3";

        const letter = document.createElement("span");
        letter.className = "answer-letter mono flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-sm font-bold";
        letter.textContent = letters[optionIndex];

        const text = document.createElement("span");
        text.textContent = option;

        inner.append(letter,text);
        button.appendChild(inner);

        button.addEventListener("click",()=>{
          answers[index] = optionIndex;
          renderQuestion();
        });

        list.appendChild(button);
      });

      el("prev-button").disabled = index === 0;
      renderNav();

      const panel = el("question-panel");
      panel.classList.remove("enter");
      void panel.offsetWidth;
      panel.classList.add("enter");
    }

    function previous(){
      if(globalIndex() === 0) return;

      if(currentQuestion > 0){
        currentQuestion--;
      } else {
        currentLevel--;
        currentQuestion = levels[currentLevel].questions.length - 1;
      }
      renderQuestion();
    }

    function next(){
      if(currentQuestion < levels[currentLevel].questions.length - 1){
        currentQuestion++;
        renderQuestion();
        return;
      }
      showAchievement();
    }

    function showAchievement(){
      const start = globalIndex() - currentQuestion;
      const questions = levels[currentLevel].questions;
      const correct = questions.reduce((sum,question,index)=>sum + (answers[start + index] === question[2] ? 1 : 0),0);
      const final = currentLevel === levels.length - 1;

      el("quiz-view").classList.add("hidden");
      el("badge-view").classList.remove("hidden");
      el("achievement-title").textContent = final ? "Level 5 Tuntas!" : "Level " + (currentLevel + 1) + " Tuntas!";
      el("achievement-copy").textContent = final
        ? "Kamu telah menaklukkan seluruh jalur Sistem Pencernaan. Saatnya melihat hasil belajarmu."
        : "Lencana baru berhasil dikumpulkan. Energi belajarmu siap untuk level berikutnya.";
      el("level-score").textContent = correct + " / " + questions.length;
      el("achievement-badge").textContent = levels[currentLevel].badge;
      el("continue-level-button").dataset.final = final ? "true" : "false";

      el("badge-view").classList.add("enter");
      window.scrollTo({top:0,behavior:"smooth"});
    }

    function continueLevel(){
      el("badge-view").classList.add("hidden");

      if(el("continue-level-button").dataset.final === "true"){
        showResult();
        return;
      }

      unlockedLevel = Math.max(unlockedLevel,currentLevel + 1);
      currentLevel++;
      currentQuestion = 0;
      el("quiz-view").classList.remove("hidden");
      renderQuestion();
      window.scrollTo({top:0,behavior:"smooth"});
    }

    function tick(){
      const minutes = Math.floor(seconds / 60);
      const remainingSeconds = seconds % 60;
      el("timer").textContent = String(minutes).padStart(2,"0") + ":" + String(remainingSeconds).padStart(2,"0");

      if(seconds <= 0){
        clearInterval(timerId);
        el("badge-view").classList.add("hidden");
        showResult();
      } else {
        seconds--;
      }
    }

    function showResult(){
      clearInterval(timerId);

      const correct = answers.reduce((sum,answer,index)=>sum + (answer === allQuestions[index][2] ? 1 : 0),0);
      const score = Math.round(correct / totalQuestions * 100);

      el("score-value").textContent = score;
      el("correct-value").textContent = correct + "/" + totalQuestions;
      el("result-message").textContent = score >= 90
        ? "Luar biasa. Kamu menuntaskan seluruh level dengan presisi tinggi!"
        : score >= 70
          ? "Pemahamanmu kuat. Tinjau ringkasan untuk memperdalam beberapa konsep."
          : "Progres terdeteksi. Ulangi kuis untuk memperkuat konsep yang masih menantang.";

      el("quiz-view").classList.add("hidden");
      el("result-view").classList.remove("hidden");

      const review = el("review-list");
      review.replaceChildren();

      allQuestions.forEach((question,index)=>{
        const right = answers[index] === question[2];
        const card = document.createElement("article");
        card.className = "rounded-2xl border p-4 " + (right ? "border-[#4e8647] bg-[#11261e]" : "border-[#85345f] bg-[#291324]");

        const row = document.createElement("div");
        row.className = "flex gap-3";

        const marker = document.createElement("span");
        marker.className = "mono mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full " + (right ? "bg-[#c8ff3d] text-[#0b1014]" : "bg-[#ff3bbf] text-white");
        marker.textContent = right ? "✓" : "!";

        const content = document.createElement("div");
        const title = document.createElement("p");
        title.className = "font-bold text-[#f4f4ff]";
        title.textContent = (index + 1) + ". " + question[0];

        const answer = document.createElement("p");
        answer.className = "mt-1 text-sm text-[#c4c6df]";
        answer.textContent = "Jawaban benar: ";

        const strong = document.createElement("strong");
        strong.textContent = question[1][question[2]];
        answer.appendChild(strong);

        content.append(title,answer);
        row.append(marker,content);
        card.appendChild(row);
        review.appendChild(card);
      });

      window.scrollTo({top:0,behavior:"smooth"});
    }

    function restart(){
      currentLevel = 0;
      currentQuestion = 0;
      answers = Array(totalQuestions).fill(null);
      unlockedLevel = 0;
      seconds = 900;

      el("result-view").classList.add("hidden");
      el("badge-view").classList.add("hidden");
      el("quiz-view").classList.remove("hidden");

      clearInterval(timerId);
      tick();
      timerId = setInterval(tick,1000);
      renderQuestion();
    }

    el("prev-button").addEventListener("click",previous);
    el("next-button").addEventListener("click",next);
    el("continue-level-button").addEventListener("click",continueLevel);
    el("restart-button").addEventListener("click",restart);

    levels.forEach((_,index)=>{
      el("level-" + index).addEventListener("click",()=>{
        if(index <= unlockedLevel){
          currentLevel = index;
          currentQuestion = 0;
          renderQuestion();
        }
      });
    });

    document.addEventListener("DOMContentLoaded",()=>{
      lucide.createIcons();
      tick();
      timerId = setInterval(tick,1000);
      renderQuestion();
    });
  </script>
 </body>
</html>
